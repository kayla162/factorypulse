# 複製成 .env 後填入。.env 不進版控。
MSSQL_ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
MSSQL_PORT=14330

# 留空 = 用 SQLite（data/factorypulse.db），不需 Docker 也能跑
# 用 MS SQL：mssql+pymssql://sa:<密碼>@127.0.0.1:14330/factorypulse
FP_DB_URL=

# 給 n8n 呼叫 API 用的金鑰（隨便產生一串長亂碼）
FP_API_TOKEN=change-me

# 選填：Gemini 金鑰（信件分類用），沒有就只用規則分類
GEMINI_API_KEY=
FP_GEMINI_MODEL=gemini-2.5-flash

# 選填：LINE Messaging API。沒填時 n8n 會送到本機假 LINE（outbox/line_mock.jsonl）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=

# 選填：1＝儀表板不需輸入金鑰（只適合埠只綁本機的示範環境）。會寫入資料的 API 仍需金鑰。
FP_DASHBOARD_PUBLIC=0
